# Environment of the production containers (docker-compose.prod.yml → env_file: prod.env).
# Copy to prod.env next to the compose file and fill in; prod.env is never committed.
# Variables: docs/08-testing-and-infra.md → «Окружение».

# --- PostgreSQL (db, migrate, api, backup) ---
POSTGRES_USER=lowisko
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=lowisko
# The same user, password and database; host `db` is the compose service.
DATABASE_URL=postgresql://lowisko:change-me-long-random@db:5432/lowisko

# --- API ---
NODE_ENV=production
# Both are the site origin: Caddy serves the app and proxies /api on one host.
WEB_URL=https://lowisko.example.pl
API_URL=https://lowisko.example.pl
# openssl rand -hex 32
JWT_ACCESS_SECRET=
# pnpm --filter api keys:qr (two lines, PEM with \n)
QR_SIGNING_PRIVATE_KEY=
QR_SIGNING_PUBLIC_KEY=
SMTP_URL=smtps://user:password@smtp.example.pl:465
MAIL_FROM=Łowisko <no-reply@lowisko.example.pl>
NOMINATIM_USER_AGENT=lowisko/1.0 (contact@example.pl)

# Przelewy24 sandbox (ADR-0004); `fake` is refused in production.
PAYMENTS_PROVIDER=p24
P24_MERCHANT_ID=
P24_POS_ID=
P24_API_KEY=
P24_CRC=

# Demo data for the defense (docs/07-security.md → «Общий пароль демо-аккаунтов»): at least
# 16 characters in production; every start re-seeds and ends the demo accounts' sessions.
SEED_DEMO=false
SEED_DEMO_PASSWORD=

# --- backup (02:30 Europe/Warsaw by default) ---
# BACKUP_CRON=30 2 * * *
# BACKUP_KEEP_DAYS=14
# BACKUP_DISK_WARN_PERCENT=80
# BACKUP_ON_START=false
