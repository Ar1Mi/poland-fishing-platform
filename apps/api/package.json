{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --watch",
    "test:e2e": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --config test/jest-e2e.json",
    "import:waters": "tsx src/cli/import-waters.ts",
    "keys:qr": "tsx src/cli/generate-qr-keys.ts",
    "e2e:server": "nest build && tsx test/e2e-server.ts",
    "postinstall": "prisma generate",
    "openapi:export": "rm -rf dist-openapi && tsc -p tsconfig.build.json --outDir dist-openapi --sourceMap false && node dist-openapi/openapi/export-openapi.js dist-openapi/openapi.json"
  },
  "dependencies": {
    "@lowisko/shared": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.3",
    "file-type": "22.1.1",
    "helmet": "8.3.0",
    "jose": "6.2.13",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.1.7",
    "pdfkit": "0.20.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.3",
    "@testcontainers/postgresql": "12.2.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.7",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "tsx": "4.23.15",
    "typescript": "catalog:"
  },
  "jest": {
    "rootDir": "src",
    "testEnvironment": "node",
    "testRegex": "\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.json"
        }
      ]
    }
  }
}
