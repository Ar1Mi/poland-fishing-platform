{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"],
        "blockedUrlPatterns": ["tile.openstreetmap.org"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.8, "aggregationMethod": "median-run" }],
        "categories:accessibility": [
          "error",
          { "minScore": 0.9, "aggregationMethod": "median-run" }
        ],
        "categories:best-practices": [
          "warn",
          { "minScore": 0.9, "aggregationMethod": "median-run" }
        ],
        "categories:seo": ["warn", { "minScore": 0.9, "aggregationMethod": "median-run" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "perf/report/lighthouse"
    }
  }
}
