{
  "name": "lowisko",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "^24.9.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.9.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "build": "pnpm -r --if-present run build",
    "lint": "eslint --max-warnings=0",
    "typecheck": "pnpm --filter @lowisko/shared run build && pnpm -r run typecheck",
    "test": "pnpm --filter @lowisko/shared run build && pnpm -r --if-present run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky && pnpm --filter @lowisko/shared run build"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,yml,yaml,css,html}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-i18next": "6.1.5",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "typescript": "catalog:",
    "typescript-eslint": "8.71.1"
  }
}
