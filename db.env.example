# PostgreSQL account of the production stack (docker-compose.prod.yml → env_file: db.env), read by
# db and backup only: they never see the API's secrets in prod.env. Copy to db.env and fill in;
# DATABASE_URL in prod.env uses the same user, password and database.
POSTGRES_USER=lowisko
# openssl rand -hex 32
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=lowisko

# Backup (01:30 Warsaw time by default — see docs/08-testing-and-infra.md):
# BACKUP_CRON=30 1 * * *
# BACKUP_KEEP_DAYS=14
# BACKUP_DISK_WARN_PERCENT=80
# BACKUP_ON_START=false
